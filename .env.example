# ==============================================================================
# Portfolio Environment Configuration
# Copy this file to `.env.local` for local development.
# In Vercel, add these variables under Project Settings -> Environment Variables.
# Only variables prefixed with VITE_ are exposed to client-side code.
# Never store private API secrets or credentials in VITE_ variables.
# ==============================================================================

# Optional: Public site URL used for canonical metadata
VITE_SITE_URL=https://myportfolio-nine-fawn-32.vercel.app/

# Optional: Public contact email displayed in the Contact section
VITE_CONTACT_EMAIL=saleleiroauwal@gmail.com

# Optional: GitHub profile URL (defaults to https://github.com/saleleiroauwal)
VITE_GITHUB_URL=

# Optional: Path or URL to downloadable CV file (defaults to /Auwal_Salele_Iro_CV.pdf)
VITE_CV_URL=/Auwal_Salele_Iro_CV.pdf

# Optional: Override form submission endpoint (defaults to FormSubmit for VITE_CONTACT_EMAIL;
# set to Formspree https://formspree.io/f/your-id or Web3Forms https://api.web3forms.com/submit if preferred)
VITE_CONTACT_FORM_ENDPOINT=

# Optional: Web3Forms public access key (only needed if using Web3Forms)
VITE_WEB3FORMS_ACCESS_KEY=

